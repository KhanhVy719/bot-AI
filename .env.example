# User token của tài khoản Discord (KHÔNG phải bot token)
# Lấy từ DevTools (Ctrl+Shift+I) > Console > paste script lấy token
DISCORD_USER_TOKEN=

AI_BASE_URL=https://ai.khanhwiee.site/v1
AI_API_KEY=
AI_MODEL=cx/gpt-5.5

# Optional
BOT_PREFIX=!
ENABLE_HISTORY=true
REPLY_TO_BOT_REPLIES=true
MAX_HISTORY_MESSAGES=12
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1200
SYSTEM_PROMPT=Ban la mot bot Discord huu ich. Tra loi tu nhien bang tieng Viet, ngan gon va dung trong tam neu nguoi dung khong yeu cau chi tiet.

# Vision limits for images embedded in DOCX/PDF
MAX_EMBEDDED_IMAGES=24
MAX_EMBEDDED_IMAGE_BYTES=4194304
MAX_EMBEDDED_IMAGE_TOTAL_BYTES=10485760
MAX_PDF_PAGES_FOR_VISION=4
PDF_SCREENSHOT_WIDTH=1200
